NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duecue
FRONTEND_URL=http://localhost:5173
# Optional comma-separated exact origins for Vercel Previews. No wildcards.
FRONTEND_URLS=
PUBLIC_API_URL=http://localhost:4000
AUTH_MODE=dev
EMAIL_MODE=preview
ENABLE_JOBS=false
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM key for networkless JWT verification. If omitted, Clerk verifies through its JWKS.
CLERK_JWT_KEY=
# Comma-separated production origins permitted to mint session tokens for this API.
CLERK_AUTHORIZED_PARTIES=
# Optional: only set on a dedicated recruiter-demo database to map one Clerk user to seeded demo data.
RECRUITER_DEMO_CLERK_USER_ID=
RESEND_API_KEY=
EMAIL_FROM="DueCue <noreply@example.com>"
